{
    "compilerOptions": {
        "target": "es2022",
        "lib": ["es2017"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "noImplicitReturns": true,
        "noUnusedLocals": true,
        "strict": true,
        "newLine": "lf",
        "types": ["mocha", "node"]
    },
    "include": ["*.ts"]
}
